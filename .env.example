# Static Node build: export these values in the shell/build environment.
SAFEK_SITE_ENV=staging
SEO_SITE_URL=https://safek-one.vercel.app
PRODUCTION_SITE_URL=https://safek.com.br
SEO_ALLOW_INDEXING=false
SAFEK_ANALYTICS_ENABLED=false
SAFEK_GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Local review includes drafts; Vercel builds and production never include drafts.
SAFEK_INCLUDE_DRAFTS=true
# Future launch ONLY after approval: SAFEK_SITE_ENV=production + SEO_ALLOW_INDEXING=true
# No DNS, webmaster submission or deployment is performed by these variables.
